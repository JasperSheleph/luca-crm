# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.
# Supabase is renaming these: "publishable key" = anon, "secret key" = service_role.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side ONLY. Bypasses RLS entirely. Never prefix this NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for the pg_cron -> /api/cron route. Generate: openssl rand -hex 32
CRON_SECRET=

# Where the app is reachable from the internet, e.g. https://crm.lucaelevators.com
# The DATABASE calls the app on a schedule, so it needs a public address — not
# localhost. Used by `npm run cron:setup` only. See docs/NOTIFICATIONS.md.
APP_URL=

# Per-source key for POST /api/leads/inbound (WordPress form, CSV upload)
LEADS_INBOUND_API_KEY=

# WhatsApp Cloud API — ships disabled, leave blank for MVP
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
