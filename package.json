{
  "name": "luca-crm",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "set -a && . ./.env.local && set +a && supabase db push --db-url \"$SUPABASE_DB_URL\"",
    "db:seed": "tsx scripts/seed.ts",
    "users:seed": "tsx scripts/seed-users.ts",
    "cron:setup": "tsx scripts/setup-cron.ts",
    "db:status": "set -a && . ./.env.local && set +a && supabase migration list --db-url \"$SUPABASE_DB_URL\"",
    "import:meta": "tsx scripts/import-meta.ts",
    "cities:renormalize": "tsx scripts/renormalize-cities.ts",
    "dev:lan": "node -e \"const o=require('os').networkInterfaces();const ip=Object.values(o).flat().find(n=>n&&n.family==='IPv4'&&!n.internal);console.log('\\n  Phone on the same Wi-Fi:  http://'+(ip?ip.address:'?')+':3000\\n  If that address is new, add it to allowedDevOrigins in next.config.ts.\\n')\" && next dev"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.60.0",
    "next": "16.3.3",
    "papaparse": "^5.5.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "supabase": "^2.60.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
